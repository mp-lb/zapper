{
  "name": "@mp-lb/zapper-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:cli": "pnpm --filter @mp-lb/zapper dev",
    "dev:docs": "pnpm --filter @mp-lb/zapper-docs dev",
    "dev:landing": "pnpm --filter @mp-lb/zapper-landing-page dev",
    "dev:renderer": "pnpm --filter @mp-lb/zapper dev:renderer",
    "docs:build": "pnpm --filter @mp-lb/zapper-docs build",
    "docs:start": "pnpm --filter @mp-lb/zapper-docs start",
    "docs:gen": "pnpm --filter @mp-lb/zapper docs:gen",
    "docs:check": "pnpm --filter @mp-lb/zapper docs:check",
    "typecheck": "turbo typecheck",
    "test": "pnpm --filter @mp-lb/zapper-sdk test && pnpm --filter @mp-lb/zapper-react test && pnpm --filter @mp-lb/zapper test",
    "test:watch": "pnpm --filter @mp-lb/zapper test:watch",
    "test:e2e": "pnpm --filter @mp-lb/zapper test:e2e",
    "test:e2e:local": "pnpm --filter @mp-lb/zapper test:e2e:local",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.0",
    "@eslint/js": "9.39.4",
    "@mp-lb/fssstack-config": "0.3.1",
    "@mp-lb/fssstack-testing": "0.1.1",
    "@types/node": "25.6.0",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.5",
    "globals": "17.5.0",
    "prettier": "3.8.3",
    "tsx": "4.20.6",
    "turbo": "2.9.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.1",
    "vitest": "4.1.5"
  }
}
