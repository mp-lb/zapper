{
  "name": "@mp-lb/zapper",
  "version": "0.18.1",
  "description": "A lightweight dev environment runner for local multi-service projects",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "zap": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc --project tsconfig.build.json && node scripts/add-js-extensions.mjs && node scripts/inject-analytics-config.mjs && chmod +x dist/index.js",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "dev:renderer": "NODE_ENV=development tsx src/dev/rendererVibeSheet.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "bash ./etc/e2e_run.sh",
    "test:e2e:local": "pnpm build && vitest run --config vitest.e2e.config.ts",
    "docs:gen": "tsx scripts/gen-cli-docs.ts",
    "docs:check": "tsx scripts/gen-cli-docs.ts --check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "cli",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mp-lb/zapper"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@mp-lb/cli-docs": "^0.0.1",
    "@types/commander": "^2.12.5",
    "@types/dotenv": "^8.2.3",
    "@types/mustache": "^4.2.5",
    "tsx": "4.20.6",
    "typescript": "6.0.3",
    "vitest": "4.1.5"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "dotenv": "^17.2.1",
    "dotenv-expand": "^12.0.3",
    "enquirer": "^2.4.1",
    "mustache": "^4.2.0",
    "pm2": "^7.0.1",
    "yaml": "^2.8.1",
    "zod": "^4.1.5"
  }
}
